# Copy these into Render Dashboard -> your service -> Environment
# NEVER commit a real .env file to git

# ---- OpenRouter (AI provider) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4
MAX_TOKENS=1024
TEMPERATURE=0.7

# ---- Firebase ----
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ---- Flutterwave ----
FLW_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx
FLW_WEBHOOK_HASH=choose-any-random-secret-string-here

# ---- App config ----
ALLOWED_ORIGIN=https://kachi95-gif.github.io
NODE_ENV=production
FREE_DAILY_MESSAGES=20
PREMIUM_DAILY_MESSAGES=1000
PORT=3000
